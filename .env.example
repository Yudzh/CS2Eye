APP_NAME=CS2Eye API
APP_ENV=local
DEBUG=true

POSTGRES_DB=cs2eye
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5433/cs2eye
DEMO_STORAGE_ROOT=/app/storage
# Host directory mounted to DEMO_STORAGE_ROOT by compose.local.yml.
DEMO_STORAGE_HOST_PATH=/media/eugene/HDD2/demos
DEMO_MAX_FILE_SIZE_BYTES=2147483648
DEMO_ARCHIVE_MAX_DEPTH=5
DEMO_DELETE_AFTER_SUCCESSFUL_PARSE=false
MAX_RANKING_SNAPSHOT_AGE_DAYS=14

BO3_API_BASE_URL=https://api.bo3.gg/api/v2
BO3_SITE_BASE_URL=https://bo3.gg
BO3_REQUEST_TIMEOUT_SECONDS=20
BO3_USER_AGENT=CS2Eye/0.1 (+local analytics project)

# Optional local pre-match LLM explanation layer.
MATCH_LLM_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
MATCH_LLM_MODEL=qwen3:8b
MATCH_LLM_PROVIDER=ollama
MATCH_LLM_PROMPT_VERSION=match_analysis_prompt.v3
MATCH_LLM_TIMEOUT_SECONDS=60
MATCH_LLM_THINK=false

# Заполняйте только если контейнеру нужен явный прокси.
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# NO_PROXY=db,api,webui,localhost,127.0.0.1

PGADMIN_EMAIL=admin@cs2eye.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

API_PORT=8000
WEBUI_PORT=5173
