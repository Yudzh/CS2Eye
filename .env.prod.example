# Copy to .env.prod. Use a random hex password (openssl rand -hex 32).
POSTGRES_DB=cs2eye
POSTGRES_USER=cs2eye
POSTGRES_PASSWORD=
TELEGRAM_BOT_TOKEN=

# Optional outbound proxy for BO3 only. Store credentials here, never in Git.
# Example format: http://USER:PASSWORD@PROXY_HOST:PORT
BO3_PROXY_URL=

# Optional Telegram transport proxy; backend API traffic stays direct.
TELEGRAM_PROXY_URL=
